root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# using directive order
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming rules
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# Formatting
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion

# Resource leaks. The bar stays open all day and creates an icon, a font and a menu while it
# runs, so an object that is never released stays lost for as long as the session lasts. These
# three rules are the ones that find it, and all three are off in the default set. The rest of
# that set is left alone: the build treats a warning as an error, so a rule turned on here is a
# rule that has to pass.
#
# CA1001  a type that holds a disposable field has to be disposable itself
# CA2000  a disposable object created and then dropped without being disposed
# CA2213  a disposable field that Dispose does not release
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2213.severity = warning

# Windows Forms hands ownership over on the call: a control added to a Controls collection, or
# an item added to a menu, is disposed by whatever it was added to. Without this option CA2000
# reports every one of them as dropped, which is exactly the code that is already correct.
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_method_call = true
