<Project>

  <!-- Settings shared by every project. Imported before each project file. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Allows building the Windows targets on other operating systems. Ignored on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- The SDK turns its analyzers on by default only for net5.0 and later, which would leave
         the net48 target unanalysed. This line covers both targets. Every rule keeps its default
         severity; the three that find a resource left undisposed are raised to warnings in
         .editorconfig, and the build treats a warning as an error. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Without this the SDK appends the commit hash to InformationalVersion, and Windows shows
         the result as the product version: "v0.1.0+5bf40ad...". The number a user reads should be
         the number of the release. The commit is still recoverable from the tag. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Product>WindowsSimpleTaskTabBar</Product>
    <!-- The fallback version, used by local builds, branch builds and manual workflow runs. A
         release overrides it: .github/workflows/release.yml passes the tag, minus its leading v,
         as -p:Version, so a published executable carries the version of its release. It is set to
         the version last released, so a build taken from a branch does not claim to be older than
         the release it came after. Preparing a release moves it on with the changelog heading. -->
    <Version>0.7.0</Version>
    <Company>Kaoru Ishikura</Company>
    <Authors>Kaoru Ishikura</Authors>
    <Copyright>Copyright (c) 2026 Kaoru Ishikura</Copyright>
  </PropertyGroup>

</Project>
