<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 needs no runtime install; net8.0-windows is the modern target. One build produces both. -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WindowsSimpleTaskTabBar</AssemblyName>
    <RootNamespace>WindowsSimpleTaskTabBar</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyTitle>WindowsSimpleTaskTabBar</AssemblyTitle>
    <Description>A slim always-on bar above the Windows taskbar that shows open windows as tabs.</Description>
    <!-- The executable's icon. The tray icon is read back out of the executable at run time,
         so this one file serves both and there is no second copy to keep in step. -->
    <!-- Forward slash: this project is also built on Linux, where MSBuild does not
         translate a backslash in this property. -->
    <ApplicationIcon>Properties/app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- For net48, skip the config file so the output is a single executable. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    DataContractJsonSerializer, used to read and write the settings file. It is part of the
    shared framework on net8.0, but .NET Framework needs the assembly referenced explicitly.
    Referencing it avoids taking a NuGet dependency for something both targets already ship.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- Required to build the net48 target on non-Windows machines. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Core sources are compiled straight into this project. A DLL reference would mean shipping
    two files, so the sources are shared instead to keep distribution to a single executable.
    The test project references Core as a normal library.
  -->
  <ItemGroup>
    <Compile Include="..\WindowsSimpleTaskTabBar.Core\**\*.cs"
             Exclude="..\WindowsSimpleTaskTabBar.Core\bin\**;..\WindowsSimpleTaskTabBar.Core\obj\**"
             LinkBase="Core" />
  </ItemGroup>

</Project>
